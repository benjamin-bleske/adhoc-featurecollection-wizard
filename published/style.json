        "keywords": [
          "adhoc",
          "carmaconf://infoBoxMapping:function createInfoBoxInfo(p){ var M = { \"hauptnutzungen\": function createInfoBoxInfo(p){ return { header: 'FNP Hauptnutzungen', headerColor: p.farbe || '#7C7CA6', title: p.nutzung, subtitle: p.text_recht || '', additionalInfo: p.name || '' }; }, \"bplanverfahren\": function createInfoBoxInfo(p) { const f = p.targetProperties || p; let qualitaet; if (f.qualitaet.startsWith('ge')) { qualitaet = f.qualitaet + ' (flurstücksscharf)'; } if (f.qualitaet.startsWith('un')) { qualitaet = f.qualitaet + ' (auf +/- 1 m genau)'; } color = \"#20EE20\"; const info = { headerColor: color, genericLinks: [ { url: \"https://digital-twin-wuppertal-live.github.io/bplan-auskunft//#/docs/\" + f.verfahren + \"/1/1\", tooltip: \"Dokumente\", iconname: \"file-pdf-o\" }, { url: 'https://www.wuppertal.de/vv/produkte/102/Bebauungsplaene_B-Plan_Auskunft_und_Verkauf.php', tooltip: 'planungsrechtliche Auskunft' } ], header: 'B-Plan-Verfahren (rechtsverbindlich)', title: f.verfahren + ' ' + f.name, additionalInfo: 'Genauigkeit: ' + qualitaet, subtitle: 'Rechtskräftig seit: ' + f.datum, }; return info; }, \"landschaftsundnaturschutz\": function createInfoBoxInfo(p) { const isSchutzgebiet = p.carmaInfo?.sourceLayer === 'landschaftsundnaturschutz'; if (!isSchutzgebiet) return null; const headerColors = { 'LS': '#92D050', 'NS': '#FF6B6B' }; const headers = { 'LS': 'Landschaftsschutzgebiet', 'NS': 'Naturschutzgebiet' }; const headerColor = headerColors[p.sg_typ] || '#CCCCCC'; const header = headers[p.sg_typ] || 'Schutzgebiet'; if (p.sg_typ === 'NS') { return { headerColor: headerColor, header: header, title: p.nrw_name, additionalInfo: '<html>Objektkennung: ' + p.nrw_nummer + '<br/>' + 'Fläche: ' + (p.flaeche / 1000000).toFixed(2) + ' km²</html>' }; } if (p.sg_typ === 'LS') { return { headerColor: headerColor, header: header, title: '<html><span style=\"font-weight: normal; font-size: 12px; font-weight:500;\">Fläche: ' + (p.flaeche / 1000000).toFixed(2) + ' km²</span></html>' }; } return null; }, \"bodenfunktion\": function createInfoBoxInfo(p) {let color=''; let kategorie=''; if (p.ges=='0'){color='#E1E1E1', kategorie='Siedlungsfläche'} if (p.ges=='-9'){color='#0070FF', kategorie='Gewässer'} if (p.ges=='1'){color='#F9E3A0', kategorie='sehr gering'} if (p.ges=='2'){color='#F9E3A0', kategorie='gering'} if (p.ges=='3'){color='#F9E3A0', kategorie='mittel'} if (p.ges=='4'){color='#A0DD87', kategorie='hoch'} if (p.ges=='5'){color='#438443', kategorie='sehr hoch'} if (!p.ges){color='#FFFFFF', title='keine Daten'}; const info = { subtitle:  '<html><div style=\"width:100%; height:100%; margin-top:0px; display:flex; align-items:center; justify-content:left; font-size:18px; font-weight:normal; \">'+kategorie+'</div></html>', title: 'Schutzwürdigkeit:', header:'Gesamtbewertung der Bodenfunktion', headerColor:color, }; return info; } }; var sl = p.carmaInfo && p.carmaInfo.sourceLayer; if (sl && M[sl]) { return M[sl](p); } var e = function (x) { return String(x).split('&').join('&amp;').split('<').join('&lt;'); }; var t = (p.info_text || '').split('\\n').map(function (l) { var i = l.indexOf(': '); return i > 0 && i < 48 ? '<b>' + e(l.slice(0, i + 1)) + '</b>' + e(l.slice(i + 1)) : e(l); }).join('<br/>'); return { title: p.info_title, additionalInfo: '<html>' + t + \"<br/><b>WMS Regionalplan NRW:</b> keine Auswertung möglich <small>(<a href=\\\"https://www.wms.nrw.de/legends/wms/wms_nw_regionalplan/Legende.png\\\">Legende</a> · <a href=\\\"https://www.wms.nrw.de/wms/wms_nw_regionalplan?REQUEST=GetCapabilities&amp;SERVICE=WMS\\\">Capabilities</a>)</small><br/><b>WMS Landesentwicklungsplan NRW:</b> Siedlungsraum (100 %) <small>(<a href=\\\"https://www.wms.nrw.de/legends/wms/wms_nw_landesentwicklungsplan/landesentwicklungsplan.png\\\">Legende</a> · <a href=\\\"https://www.wms.nrw.de/wms/wms_nw_landesentwicklungsplan?REQUEST=GetCapabilities&amp;SERVICE=WMS\\\">Capabilities</a>)</small>\" + '</html>' }; }"
        ]
