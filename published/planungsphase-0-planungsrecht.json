pan></html>' }; } return null; } }; var sl = p.carmaInfo && p.carmaInfo.sourceLayer; if (sl && M[sl]) { return M[sl](p); } var e = function (x) { return String(x).split('&').join('&amp;').split('<').join('&lt;'); }; var t = ((p.info_text || '') + '\\n' + (p.info_planungsrecht || '')).split('\\n').filter(function (l) { return l; }).map(function (l) { var i = l.indexOf(': '); return i > 0 && i < 48 ? '<b>' + e(l.slice(0, i + 1)) + '</b>' + e(l.slice(i + 1)) : e(l); }).join('<br/>'); return { title: p.info_title, additionalInfo: '<html>' + \"\" + t + \"<br/><b>WMS Regionalplan NRW:</b> keine Auswertung möglich <small>(<a href=\\\"https://www.wms.nrw.de/legends/wms/wms_nw_regionalplan/Legende.png\\\">Legende</a> · <a href=\\\"https://www.wms.nrw.de/wms/wms_nw_regionalplan?REQUEST=GetCapabilities&amp;SERVICE=WMS\\\">Capabilities</a>)</small><br/><b>WMS Landesentwicklungsplan NRW:</b> Siedlungsraum (81 %), Freiraum (19 %) <small>(<a href=\\\"https://www.wms.nrw.de/legends/wms/wms_nw_landesentwicklungsplan/landesentwicklungsplan.png\\\">Legende</a> · <a href=\\\"https://www.wms.nrw.de/wms/wms_nw_landesentwicklungsplan?REQUEST=GetCapabilities&amp;SERVICE=WMS\\\">Capabilities</a>)</small>\" + '</html>' }; }"
